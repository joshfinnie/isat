{
    "name": "isat",
    "version": "1.0.0",
    "description": "Interactive Satellite Tracker",
    "repository": {
        "type": "git",
        "url": "git://github.com/koansys/isat.git"
    },
    "type": "module",
    "main": "./js/index.js",
    "types": "./js/index.d.ts",
    "exports": {
        ".": {
            "types": "./js/index.d.ts",
            "default": "./js/index.js"
        },
        "./sgp4": "./js/sgp4.js",
        "./twoline2rv": "./js/twoline2rv.js",
        "./getgravc": "./js/getgravc.js"
    },
    "scripts": {
        "dev": "vite serve viz --port 9999",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "eslint": "^9.0.0",
        "prettier": "^3.0.0",
        "vite": "^6.0.0",
        "vite-plugin-cesium": "^1.2.23",
        "vitest": "^3.0.0"
    },
    "dependencies": {
        "cesium": "^1.141.0"
    }
}
